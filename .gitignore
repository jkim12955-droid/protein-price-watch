# 인증키. 절대 커밋하지 않는다
.env
.env.*
!.env.example
*.key
secrets*.json

# 파생물. 원본에서 다시 만들 수 있다 (python pw.py load)
# 예외로 data/nutrient_search_cache.json 은 커밋한다.
# 지우면 식약처 API 를 715회 다시 불러야 하고, 그 API 가 간헐적으로 오류를 낸다.
# 새로 클론한 사람이 키 없이도 match 를 돌려볼 수 있게 하려는 뜻도 있다.
data/pricewatch.db
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/_*
data/raw/_*.json

